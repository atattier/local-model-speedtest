{
  "name": "local-model-speedtest",
  "version": "1.5.9",
  "private": true,
  "type": "module",
  "description": "在 DSH 模型选择器里一键测速，并在对话报错处用大白话解释失败原因（桌面端）。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atattier/local-model-speedtest.git"
  },
  "homepage": "https://github.com/atattier/local-model-speedtest#readme",
  "bugs": {
    "url": "https://github.com/atattier/local-model-speedtest/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "更好的用户体验",
      "en": "Better UX"
    },
    "icon": "bolt",
    "contributes": {
      "panels": [
        {
          "id": "speedtest",
          "title": "模型测速",
          "icon": "bolt",
          "placement": [
            "features",
            "chat.panel",
            "session.tab"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "speedLatest",
          "icon": "bolt",
          "panel": "speedtest"
        }
      ],
      "composer.actions": [
        {
          "id": "openSpeedtest",
          "label": {
            "zh": "⚡ 测速",
            "en": "⚡ Speed"
          },
          "icon": "bolt",
          "effect": {
            "type": "open",
            "page": "panel:speedtest"
          }
        }
      ],
      "composer.tools": [
        {
          "id": "toolSpeedtest",
          "label": {
            "zh": "测速",
            "en": "Speed"
          },
          "icon": "bolt",
          "panel": "speedtest"
        }
      ]
    }
  }
}
