{
  "name": "local-model-speedtest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atattier/local-model-speedtest.git"
  },
  "homepage": "https://github.com/atattier/local-model-speedtest#readme",
  "bugs": {
    "url": "https://github.com/atattier/local-model-speedtest/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "模型测速",
      "en": "Model speed"
    },
    "icon": "bolt",
    "contributes": {
      "panels": [
        {
          "id": "speedtest",
          "title": "模型测速",
          "icon": "bolt",
          "placement": [
            "features",
            "chat.panel",
            "session.tab"
          ]
        }
      ],
      "composer.strip": [
        {
          "id": "speedLatest",
          "icon": "bolt",
          "panel": "speedtest"
        }
      ]
    }
  }
}
